{
  "name": "nextjs-ethereum-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade, self-hostable EVM block explorer: indexer, Etherscan-compatible API, contract verification, gas tracker, tokens, NFTs and charts",
  "author": "Aakash Singh Rajput",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aakash4dev/nextjs-ethereum-explorer.git"
  },
  "keywords": [
    "ethereum",
    "evm",
    "blockchain",
    "explorer",
    "indexer",
    "etherscan",
    "contract-verification",
    "web3",
    "nextjs",
    "mongodb"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test 'test/**/*.test.js'",
    "sync": "node scripts/sync.js",
    "sync:once": "node scripts/sync.js --once",
    "db:indexes": "node scripts/create-indexes.js",
    "check-rpc": "node scripts/check-rpc.js",
    "reset-db": "node scripts/reset-database.js --confirm",
    "devnet:seed": "node scripts/devnet/seed.js"
  },
  "dependencies": {
    "abitype": "^1.2.3",
    "dotenv": "^16.6.1",
    "mongoose": "^8.24.5",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0",
    "solc": "^0.8.37",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
