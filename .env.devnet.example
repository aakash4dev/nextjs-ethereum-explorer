# npm run devnet uses this isolated configuration, without mainnet fallbacks.
ETHEREUM_RPC_URL=http://127.0.0.1:8545
ETHEREUM_RPC_FALLBACK_URLS=
MONGODB_URI=mongodb://127.0.0.1:27018/ethereum_explorer_devnet
NEXT_PUBLIC_CHAIN_NAME=Local Ethereum
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
NEXT_PUBLIC_SITE_URL=http://localhost:3017
CHAIN_ID=31337
START_BLOCK=0
INDEXER_BATCH_SIZE=50
INDEXER_CONCURRENCY=8
SYNC_INTERVAL=1000
INDEXER_CONFIRMATIONS=0
TRACE_MODE=callTracer
TRACK_BALANCES=true
TRACK_TOKEN_BALANCES=true
STATS_INTERVAL=5000
PRICE_PROVIDER=off
SIGNATURE_LOOKUP=false
API_RATE_LIMIT_PER_MINUTE=0
TRUST_PROXY=false
LOG_LEVEL=info
