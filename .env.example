# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# JSON-RPC endpoint(s). Comma-separated URLs are used with automatic failover.
# An archive node with debug_/trace_ APIs enables internal transactions and
# historical balances; any standard node works for everything else.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# ETHEREUM_RPC_FALLBACK_URLS=https://rpc.ankr.com/eth,https://eth.llamarpc.com

# MongoDB connection string (local, Docker or Atlas).
MONGODB_URI=mongodb://localhost:27017/ethereum_indexer
# MONGODB_POOL_SIZE=20

# ─────────────────────────────────────────────────────────────────────────────
# Chain & branding
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_NAME=Ethereum
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
# Public URL of the site (used for metadata, sitemap, API docs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: skip eth_chainId auto-detection.
# CHAIN_ID=1
# Optional extra name tags: '{"0xabc...":"My Contract"}'
# LABELS_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# Indexer (npm run sync)
# ─────────────────────────────────────────────────────────────────────────────
# First block to index. Use a recent block for a quick start on mainnet.
START_BLOCK=0
# Blocks per batch, and how many blocks are fetched in parallel.
INDEXER_BATCH_SIZE=10
INDEXER_CONCURRENCY=4
# Poll interval (ms) once caught up with the chain head.
SYNC_INTERVAL=5000
# Stay N blocks behind the head (0 = index the head; reorgs are handled anyway).
INDEXER_CONFIRMATIONS=0
INDEXER_MAX_REORG_DEPTH=64
# Internal transactions: auto | callTracer (geth/reth/anvil) | parity (erigon/nethermind) | off
TRACE_MODE=auto
# Refresh native and token balances of touched accounts after each batch.
TRACK_BALANCES=true
TRACK_TOKEN_BALANCES=true
# How often (ms) daily chart statistics are recomputed.
STATS_INTERVAL=60000
# RPC_TIMEOUT_MS=20000
# RPC_BATCH_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────
# Web / API
# ─────────────────────────────────────────────────────────────────────────────
# Requests per minute per client IP for /api routes (0 disables).
API_RATE_LIMIT_PER_MINUTE=120
# Trust X-Forwarded-For (set false if not behind a reverse proxy).
TRUST_PROXY=true
# Enables POST /api/indexer (run one batch from cron/serverless). Use a long random value.
# ADMIN_API_KEY=
# /api/health returns 503 when the indexer is more than this many blocks behind.
# HEALTH_MAX_BLOCK_LAG=50

# ─────────────────────────────────────────────────────────────────────────────
# Integrations
# ─────────────────────────────────────────────────────────────────────────────
# Fiat prices: coingecko | off (testnets, private chains)
PRICE_PROVIDER=coingecko
PRICE_COIN_ID=ethereum
# Look up unknown 4-byte / event signatures on openchain.xyz and 4byte.directory.
SIGNATURE_LOOKUP=true
# Solidity compilers for contract verification are downloaded and cached here.
SOLC_CACHE_DIR=.solc-cache
# SOLC_BINARIES_URL=https://binaries.soliditylang.org/bin

# LOG_LEVEL=info
